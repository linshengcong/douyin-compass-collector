# PostgreSQL 连接凭证只存进程环境或本机 .env；YAML 只引用变量名。
# 本地 compose 示例地址（collector_local 仅供本地开发，云端必须替换）。
COMPASS_DATABASE_URL=postgresql+psycopg://collector:collector_local@127.0.0.1:55432/compass
TAOBAO_DATABASE_URL=postgresql+psycopg://collector:collector_local@127.0.0.1:55432/taobao
TAOBAO_POC_DATABASE_URL=postgresql+psycopg://collector:collector_local@127.0.0.1:55432/taobao_poc
# 独立 alembic 命令使用 DATABASE_URL；测试单独设置以 _test 结尾的数据库。
DATABASE_URL=
TEST_DATABASE_URL=

# 钉钉通知使用显式开关，真实值只写入本机 .env。
DINGTALK_ENABLED=true
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=

# OSS 只在正式 CSV 发布成功后上传，并生成最长 7 天的私有下载链接。
OSS_ENABLED=false
OSS_REGION=
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_OBJECT_PREFIX=compass
OSS_DOWNLOAD_URL_EXPIRES_SECONDS=604800

# 公开网页数据独立于私有 CSV 下载链路；只公开 OSS 的 WEB_PUBLIC_PREFIX 前缀。
WEB_ENABLED=false
WEB_PUBLIC_PREFIX=compass/web
# 独立 mall-web 静态网站的公开入口；采集器只更新数据并通知该地址。
WEB_SITE_URL=
