# 本地采集使用 SQLite 文件，不需要 Docker、PostgreSQL 服务或 SSH 隧道。
# 整批正式发布后仍通过 RANKING_API_URL 同步云端业务库。
COMPASS_DATABASE_URL=sqlite:///runtime/local/compass.sqlite3
TAOBAO_DATABASE_URL=sqlite:///runtime/local/taobao.sqlite3
TAOBAO_POC_DATABASE_URL=sqlite:///runtime/local/taobao_poc.sqlite3
# 以下仅供可选 PostgreSQL 兼容验收；正常采集及 SQLite 测试不需要设置。
DATABASE_URL=
TEST_DATABASE_URL=

# 正式批次通过已有榜单 API 同步云端；真实令牌只写入本机 .env。
RANKING_API_URL=
RANKING_SYNC_TOKEN=

# 钉钉通知使用显式开关，真实值只写入本机 .env。
DINGTALK_ENABLED=true
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=

# OSS 只在正式 CSV 发布成功后上传，并生成最长 7 天的私有下载链接。
OSS_ENABLED=false
OSS_REGION=
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_OBJECT_PREFIX=compass
OSS_DOWNLOAD_URL_EXPIRES_SECONDS=604800

# 公开网页数据独立于私有 CSV 下载链路；只公开 OSS 的 WEB_PUBLIC_PREFIX 前缀。
WEB_ENABLED=false
WEB_PUBLIC_PREFIX=compass/web
# 独立 mall-web 静态网站的公开入口；采集器只更新数据并通知该地址。
WEB_SITE_URL=
